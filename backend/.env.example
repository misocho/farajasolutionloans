APP_NAME=Faraja

APP_ENV=development

SECRET_KEY=CHANGE_ME

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/faraja

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── AWS S3 (Document & Photo Storage) ─────────────────────
# Set APP_ENV=production to enable real S3 uploads.
# In development, photos are kept as base64 in memory.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=af-south-1
S3_BUCKET_NAME=faraja-loans-docs
S3_BASE_URL=                         # Optional: CDN/CloudFront URL
