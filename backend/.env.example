# ── Faraja Solution Loans — Backend Environment ──────────────────────────────
# Copy values from backend/.env for a working local setup.

# Application
APP_NAME=Faraja
APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1

# Security — generate a strong random value for production
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/faraja

# Time / storage / logging
DEFAULT_TIMEZONE=Africa/Nairobi
STORAGE_PATH=storage
LOG_LEVEL=INFO

# Email (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Faraja Solution Loans <noreply@farajasolutions.co.ke>

# Frontend (used for invite / reset links)
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,https://faraja.enkaai.net

# Invite tokens
INVITE_TOKEN_EXPIRE_HOURS=72

# ── AWS S3 (Document & Photo Storage) ─────────────────────────────
# Future scope: set APP_ENV=production to enable real S3 uploads.
# In development, photos are kept as base64 in memory.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=af-south-1
S3_BUCKET_NAME=faraja-loans-docs
S3_BASE_URL=                         # Optional: CDN/CloudFront URL
